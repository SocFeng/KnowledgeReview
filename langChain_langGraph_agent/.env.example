# ============ 必填：DashScope（阿里云百炼） ============
# 在 https://bailian.console.aliyun.com/ 申请
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM 模型：qwen-max / qwen-plus / qwen-turbo / qwen2.5-72b-instruct ...
LLM_MODEL=qwen-plus

# 采样温度（0~1，旅游规划建议 0.3~0.7）
LLM_TEMPERATURE=0.5

# LLM Provider：
#   openai_compat  —— 默认，走 DashScope 的 OpenAI 兼容端点（流式 + tool_calls 稳定，强烈推荐）
#   tongyi         —— 走 langchain-community 的 ChatTongyi（注意：streaming + tool_calls 有上游 bug）
LLM_PROVIDER=openai_compat
# 兼容模式端点：如果用自己搭的 vLLM / 其他厂商的 OpenAI 兼容接口，改这里
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 可选：高德地图 Web 服务 ============
# 不填也能跑：景点 / 路线工具会自动 fallback 到 LLM 常识
# 申请地址：https://console.amap.com/dev/key/app  （选 "Web 服务"）
AMAP_API_KEY=

# ============ 可选：tavily 联网搜索（用于实时资讯/景点开放时间等） ============
# https://app.tavily.com/   不填则关闭联网搜索工具
TAVILY_API_KEY=

# ============ Agent 行为参数 ============
# 单轮对话最多允许 Agent 调用工具的次数（防止死循环）
MAX_TOOL_ITERATIONS=10
# Streamlit 中显示工具调用过程
SHOW_TOOL_TRACE=true

# ============ 持久化路径 ============
# 会话 / checkpoint 存储位置
DATA_DIR=./data
CHECKPOINT_DB=./data/checkpoints.sqlite
