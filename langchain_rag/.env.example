# DashScope API Key（阿里云百炼平台获取）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 模型选择（可选，已有合理默认值） =====
# LLM：qwen-max / qwen-plus / qwen-turbo / qwen2.5-72b-instruct ...
LLM_MODEL=qwen-plus

# ----- Embedding -----
# 选择 embedding 提供方：dashscope (在线API) 或 huggingface (本地模型)
EMBEDDING_PROVIDER=dashscope

# DashScope 在线 embedding（EMBEDDING_PROVIDER=dashscope 时生效）
EMBEDDING_MODEL=text-embedding-v3

# 本地 HuggingFace embedding（EMBEDDING_PROVIDER=huggingface 时生效）
# 既可填本地绝对路径（推荐），也可填 HF Hub 的 model_id（首次会自动下载）
HF_EMBEDDING_MODEL=D:/models/bge-large-zh-v1.5
# 设备：auto / cpu / cuda / cuda:0
HF_EMBEDDING_DEVICE=auto
# 一次编码的 batch 大小，CPU 建议 8~16，GPU 可调到 32~64
HF_EMBEDDING_BATCH_SIZE=16
# bge / e5 等模型对查询通常需要前缀；bge-zh 系列用 "为这个句子生成表示以用于检索相关文章："
# 不需要前缀就留空
HF_EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ----- Rerank -----
# Rerank：gte-rerank-v2 (DashScope)；注意 v1 已下线
RERANK_MODEL=gte-rerank-v2

# ===== 切片参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ===== 检索参数 =====
# 向量检索 Top-K
VECTOR_TOP_K=5
# BM25 检索 Top-K
BM25_TOP_K=5
# Rerank 之后保留的最终文档数
RERANK_TOP_N=4

# ===== 路径配置 =====
DATA_DIR=./data
STORAGE_DIR=./storage
CHROMA_COLLECTION=knowledge_base

# ===== API 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
